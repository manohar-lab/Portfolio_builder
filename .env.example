# =========================================================
# PORTFOLIOCRAFT SAAS PLATFORM - ENVIRONMENT CONFIGURATION
# =========================================================

# Application Base URL (Dynamic production or local URL)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Credentials (Public / Client-Safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=portfolio-assets

# Supabase Server-Only Secrets (NEVER expose to client bundles)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# GitHub OAuth Integration Credentials (Server-Side Only)
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
