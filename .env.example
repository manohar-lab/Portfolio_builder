# ==========================================
# PORTFOLIO BUILDER PLATFORM ENVIRONMENT VARIABLES
# ==========================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Public Credentials (Client-side accessible)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Storage Bucket Names
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=portfolio-assets

# ==========================================
# OAUTH PROVIDER CONFIGURATION INSTRUCTIONS
# ==========================================
# Configure Google & GitHub OAuth in your Supabase Auth Dashboard:
# 1. Supabase Dashboard -> Authentication -> Providers -> Google
#    - Client ID: <your-google-oauth-client-id>
#    - Client Secret: <your-google-oauth-client-secret>
#    - Authorized Redirect URI: https://your-project.supabase.co/auth/v1/callback
#
# 2. Supabase Dashboard -> Authentication -> Providers -> GitHub
#    - Client ID: <your-github-oauth-client-id>
#    - Client Secret: <your-github-oauth-client-secret>
#    - Authorization Callback URL: https://your-project.supabase.co/auth/v1/callback
